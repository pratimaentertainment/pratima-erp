# ==============================================================================
# PRATIMA ERP - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and populate all variables with your production secrets.
# NEVER commit the actual .env file with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://app.yourdomain.com"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 15+)
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
# Ensure connection pooling (e.g. PgBouncer) or pg connection string parameters
DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5432/pratima_erp?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Auth.js v5 / NextAuth)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-cryptographically-secure-random-32-character-secret"
NEXTAUTH_SECRET="replace-with-a-cryptographically-secure-random-32-character-secret"
NEXTAUTH_URL="https://app.yourdomain.com"

# Session expiration rules
SESSION_TIMEOUT_HOURS=24
REMEMBER_ME_DAYS=30

# 256-bit encryption key for BYOS tenant cloud storage credentials at rest (32 bytes hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-a-64-character-hex-encryption-key-for-tenant-secrets"

# ------------------------------------------------------------------------------
# 4. RAZORPAY PAYMENT GATEWAY & SAAS BILLING
# ------------------------------------------------------------------------------
# Found in Razorpay Dashboard -> Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_live_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_key"

# ------------------------------------------------------------------------------
# 5. PLATFORM DEFAULT S3 CLOUD STORAGE (AWS S3 / Wasabi / MinIO)
# ------------------------------------------------------------------------------
# Default system storage fallback for photo deliveries, guest selfies, and assets
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET_NAME="pratima-erp-production-assets"

# ------------------------------------------------------------------------------
# 6. GOOGLE CLOUD INTEGRATION (OAuth 2.0 & Places)
# ------------------------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_PLACES_API_KEY="your-google-places-and-maps-api-key"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-places-and-maps-api-key"

# ------------------------------------------------------------------------------
# 7. META (FACEBOOK / INSTAGRAM) LEAD ADS WEBHOOKS
# ------------------------------------------------------------------------------
# Meta Developer Portal -> App Settings -> Basic & Webhooks
META_APP_SECRET="your_meta_app_secret"
META_PAGE_ACCESS_TOKEN="your_meta_page_access_token"
META_VERIFY_TOKEN="your_custom_meta_webhook_challenge_verify_token"
