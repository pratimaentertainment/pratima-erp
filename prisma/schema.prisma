model Customer {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId String @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  customerCode String
  firstName    String
  lastName     String
  email        String?
  phone        String?
  whatsapp     String?

  // B2B & Corporate GST Information
  isCorporate Boolean @default(false)
  companyName String?
  gstin       String?
  pan         String?
  stateCode   String?

  cityId  String? @db.Uuid
  city    City?   @relation(fields: [cityId], references: [id], onDelete: SetNull)
  stateId String? @db.Uuid
  state   State?  @relation(fields: [stateId], references: [id], onDelete: SetNull)

  createdById String? @db.Uuid
  createdBy   User?   @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @db.Uuid
  updatedBy   User?   @relation("CustomerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String? @db.Uuid
  deletedBy   User?   @relation("CustomerDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  isConfirmed         Boolean   @default(false)
  portalAccessGranted Boolean   @default(false)
  portalAccessCode    String?
  portalPin           String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  confirmedAt         DateTime?

  userId String? @unique @db.Uuid
  user   User?   @relation("CustomerUserAccount", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  inquiries        Inquiry[]
  leads            Lead[]
  invoices         Invoice[]
  payments         Payment[]
  eventBookings    EventBooking[]
  storageRecords   StorageRecord[]
  clientSelections ClientSelection[]
  albumProjects    AlbumProject[]
  creditNotes      CreditNote[]

  @@unique([tenantId, customerCode])
  @@index([tenantId, branchId])
  @@index([cityId])
  @@index([stateId])
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Inquiry {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId String @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  inquiryCode String

  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  inquiryDate          DateTime  @db.Date
  eventDate            DateTime? @db.Date
  eventType            String?
  preferredContactTime String?
  budgetRange          String?

  leadSourceId String?     @db.Uuid
  leadSource   LeadSource? @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)

  assignedToId String? @db.Uuid
  assignedTo   User?   @relation("InquiryAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  priority Priority      @default(MEDIUM)
  status   InquiryStatus @default(NEW)
  notes    String?

  createdById String? @db.Uuid
  createdBy   User?   @relation("InquiryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @db.Uuid
  updatedBy   User?   @relation("InquiryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String? @db.Uuid
  deletedBy   User?   @relation("InquiryDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  lead      Lead?

  @@unique([tenantId, inquiryCode])
  @@index([tenantId, branchId, status])
  @@index([customerId])
  @@index([leadSourceId])
  @@index([assignedToId])
}

enum FollowUpType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  VIDEO_CALL
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum FollowUpOutcome {
  INTERESTED
  NOT_INTERESTED
  CALLBACK_REQUESTED
  NO_ANSWER
  INVALID_NUMBER
  MET
  OTHER
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

model FollowUp {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId String @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  leadId String @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  assignedToId String? @db.Uuid
  assignedTo   User?   @relation("FollowUpAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  type   FollowUpType
  status FollowUpStatus @default(PENDING)

  followUpDate   DateTime
  reminderDate   DateTime?
  reminderStatus ReminderStatus?
  reminderSentAt DateTime?

  priority         Priority  @default(MEDIUM)
  notes            String?
  outcome          String?
  nextFollowUpDate DateTime?
  completedAt      DateTime?

  createdById String? @db.Uuid
  createdBy   User?   @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @db.Uuid
  updatedBy   User?   @relation("FollowUpUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String? @db.Uuid
  deletedBy   User?   @relation("FollowUpDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([id, tenantId])
  @@index([tenantId, branchId, status, followUpDate])
  @@index([leadId])
}

enum DiscountType {
  PERCENTAGE
  FIXED
  FLAT
  NONE
}

enum LineItemType {
  STANDARD
  OPTIONAL
  INFORMATION
}

// ------------------------------------------------------
// DOUBLE-ENTRY ACCOUNTING & CHART OF ACCOUNTS (STEP 1)
// ------------------------------------------------------

model Account {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  type        AccountType
  isDefault   Boolean     @default(false)
  description String?     @db.Text
  code        String?

  entries VoucherEntry[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([type])
}

model FinancialVoucher {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  voucherNumber String
  date          DateTime    @default(now())
  type          VoucherType
  narration     String?     @db.Text
  referenceId   String?

  // Strict Audit Trail & Voiding (Immutability)
  isVoided          Boolean   @default(false)
  voidedAt          DateTime?
  voidedById        String?   @db.Uuid
  voidReason        String?   @db.Text
  reversalVoucherId String?   @db.Uuid

  entries          VoucherEntry[]
  staffAssignments StaffAssignment[]
  eventAssignments EventAssignment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tenantId, voucherNumber])
  @@index([tenantId])
  @@index([date])
  @@index([type])
  @@index([referenceId])
  @@index([isVoided])
}

model VoucherEntry {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucherId String           @db.Uuid
  voucher   FinancialVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  accountId String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  type   EntryType
  amount Decimal   @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([voucherId])
  @@index([accountId])
}

// ------------------------------------------------------
// CREDIT NOTES & STATUTORY ADJUSTMENTS (PHASE 9)
// ------------------------------------------------------

model CreditNote {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String           @db.Uuid
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId         String?          @db.Uuid
  branch           Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerId       String           @db.Uuid
  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceId        String           @db.Uuid
  invoice          Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  creditNoteNumber String
  status           String           @default("ISSUED") // ISSUED, REFUNDED, APPLIED
  reason           CreditNoteReason @default(CLIENT_DISCOUNT_ADJUSTMENT)
  notes            String?          @db.Text
  issueDate        DateTime         @default(now())

  // Tax and Amounts
  subtotal     Decimal @db.Decimal(10, 2)
  cgstAmount   Decimal @default(0.00) @db.Decimal(10, 2)
  sgstAmount   Decimal @default(0.00) @db.Decimal(10, 2)
  igstAmount   Decimal @default(0.00) @db.Decimal(10, 2)
  grandTotal   Decimal @db.Decimal(10, 2)
  refundAmount Decimal @default(0.00) @db.Decimal(10, 2)

  // Audit
  createdById String?   @db.Uuid
  createdBy   User?     @relation("CreditNoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  items CreditNoteItem[]

  @@unique([tenantId, creditNoteNumber])
  @@index([tenantId, invoiceId])
  @@index([tenantId, customerId])
  @@index([branchId])
}

model CreditNoteItem {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creditNoteId String     @db.Uuid
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  name       String
  sacCode    String  @default("998382")
  quantity   Int     @default(1)
  unitPrice  Decimal @db.Decimal(10, 2)
  gstRate    Decimal @default(0.00) @db.Decimal(5, 2)
  cgstAmount Decimal @default(0.00) @db.Decimal(10, 2)
  sgstAmount Decimal @default(0.00) @db.Decimal(10, 2)
  igstAmount Decimal @default(0.00) @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creditNoteId])
}
