  updatedById   String?   @db.Uuid
  updatedBy     User?     @relation("QuotationRevisionItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById   String?   @db.Uuid
  deletedBy     User?     @relation("QuotationRevisionItemDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([revisionId, tenantId, branchId])
  @@index([quotationFunctionId])
}

