generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
  PENDING_INVITATION
}

enum EmploymentType {
  IN_HOUSE
  FREELANCE
  FREELANCER
}

enum IngestionStatus {
  PENDING
  COPYING
  VERIFIED
  CORRUPT
  MISSING
}

enum PayoutStatus {
  PENDING
  ELIGIBLE_FOR_PAYMENT
  PAID
}

enum DocumentTemplateType {
  AGREEMENT
  QUOTATION_TERMS
  INVOICE_TERMS
  NDA
  OTHER
}

enum UserAgreementStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TokenType {
  RESET_PASSWORD
  EMAIL_VERIFICATION
  TEMPORARY_PASSWORD
}

enum Role {
  SUPER_ADMIN
  TENANT_OWNER
  STAFF
  DEALER

  @@map("UserSystemRole")
}

enum RoleType {
  BRANCH_MANAGER
  PROJECT_MANAGER
  SALES_MANAGER
  EDITOR
  DESIGNER
  FREELANCER
  ADMIN
  STUDIO_OWNER
}

enum PlanTier {
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  CANCELED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
  LIFETIME
}

enum LeadStatus {
  NEW
  QUALIFIED
  QUOTATION_SENT
  NEGOTIATION
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum PricingMode {
  ITEMIZED
  LUMP_SUM
}

enum AgreementStatus {
  DRAFT
  SENT
  SIGNED
}

enum StorageProvider {
  GOOGLE_DRIVE
  AWS_S3
  CLOUDFLARE_R2
}

enum IntegrationProvider {
  FACEBOOK
  GOOGLE
  INSTAGRAM
  ZAPIER
  PABBLY
  WHATSAPP
  CUSTOM
}

enum StorageRecordStatus {
  ACTIVE
  DELIVERED
  EXPIRED
  ARCHIVED
}

enum SelectionStatus {
  DRAFT
  SHARED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  EXTENSION_REQUESTED
  COMPLETED
}

enum SelectionItemStatus {
  PENDING
  SELECTED
  REJECTED
}

enum AlbumStatus {
  DRAFT
  IN_POST_PRODUCTION
  SHARED_FOR_REVIEW
  CHANGES_REQUESTED
  APPROVED_FOR_PRINT
  DELIVERED
}

enum EquipmentCategory {
  CAMERA
  LENS
  LIGHTING
  DRONE
  AUDIO
  ACCESSORY
}

enum AssetStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum LeaveType {
  SICK
  CASUAL
  ANNUAL
  MATERNITY
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum WorkflowType {
  PHOTO_EDITING
  VIDEO_EDITING
  ALBUM_DESIGN
  ALBUM_PRINTING
  RAW_INGEST
  COLOR_GRADING
  TEASER_REEL
  CINEMATIC_FILM
  DELIVERABLE
  OTHER
}

enum TaskStatus {
  PENDING
  READY
  TODO
  IN_PROGRESS
  REVIEW
  IN_REVIEW
  CLIENT_REVIEW
  CHANGES_REQUESTED
  APPROVED
  COMPLETED
  CANCELLED
}

enum RoyaltyStatus {
  PENDING
  SETTLED
  WAIVED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
  SENT
  PARTIAL
  OVERDUE
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  CHEQUE
  OTHER
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
  REFUNDED
}

enum EventBookingStatus {
  BLOCKED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum JourneyStatus {
  ENQUIRY
  BOOKED
  SHOOT_COMPLETED
  SELECTION_PENDING
  EDITING_IN_PROGRESS
  ALBUM_PRINTING
  DELIVERED
}

enum StaffAssignmentStatus {
  PENDING
  CONFIRMED
  DECLINED
  COMPLETED
}

enum GearAllocationStatus {
  ALLOCATED
  CHECKED_OUT
  IN_FIELD
  RETURNED
  DAMAGED
}

enum DispatchStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum PostProductionStatus {
  PENDING
  DATA_DUMPED
  CLIENT_SELECTION
  EDITING
  REVIEW
  DELIVERED
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum VoucherType {
  RECEIPT
  PAYMENT
  CONTRA
  JOURNAL
}

enum EntryType {
  DEBIT
  CREDIT
}

enum TdsSection {
  NONE
  SEC_194J_PROFESSIONAL
  SEC_194J_TECHNICAL
  SEC_194C_CONTRACTOR
}

enum CreditNoteReason {
  EVENT_CANCELLED
  POST_PRODUCTION_DEFICIENCY
  CLIENT_DISCOUNT_ADJUSTMENT
  OVERBILLING_CORRECTION
  OTHER
}

enum BroadcastSeverity {
  INFO
  WARNING
  CRITICAL
}

// ------------------------------------------------------
// SYSTEM & TENANT MANAGEMENT
// ------------------------------------------------------

model Tenant {
  id                         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String
  subdomain                  String?            @unique
  slug                       String             @unique
  contactPhone               String             @unique
  bio                        String?
  companyLegalName           String?
  tradeName                  String?
  logoUrl                    String?
  gstNumber                  String?
  gstinNumber                String?
  isGstRegistered            Boolean            @default(false)
  isTdsEnabled               Boolean            @default(false)
  isAdvancedInventoryEnabled Boolean            @default(false)
  isAIGuestPortalEnabled     Boolean            @default(false)
  universalStudioQrCode      String?            @unique
  panNumber                  String?            @unique
  cinNumber                  String?
  website                    String?
  email                      String?
  phone                      String?
  subscriptionStatus         SubscriptionStatus @default(TRIAL)
  trialEndsAt                DateTime?
  country                    String             @default("US")
  state                      String?
  city                       String?
  address                    String?
  postalCode                 String?
  timezone                   String             @default("UTC")
  currency                   String             @default("USD")
  language                   String             @default("en")
  fiscalYearStartMonth       Int                @default(1)
  bankDetails                Json?
  defaultPortfolioUrls       String[]           @default([])
  defaultPromoVideoUrl       String?
  whyChooseUs                String[]           @default([])
  gmbPlaceId                 String?
  isActive                   Boolean            @default(true)

  subscriptions     Subscription[]
  branches          Branch[]
  users             User[]
  vendors           Vendor[]
  packages          Package[]
  auditLogs         AuditLog[]
  roles             TenantRole[]
  leads             Lead[]
  numberSeries      NumberSeries[]
  activityTimelines ActivityTimeline[]
  attachments       Attachment[]
  states            State[]
  cities            City[]
  eventTypes        EventType[]
  leadSources       LeadSource[]
  paymentModes      PaymentMode[]
  packageCategories PackageCategory[]
  taxRates          TaxRate[]
  serviceComponents ServiceComponent[]
  customers         Customer[]
  inquiries         Inquiry[]

  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  followUps              FollowUp[]
  packageItems           PackageItem[]
  quotationRevisions     QuotationRevision[]
  quotationRevisionItems QuotationRevisionItem[]
  invoices               Invoice[]
  invoiceItems           InvoiceItem[]
  payments               Payment[]
  eventBookings          EventBooking[]
  subEvents              SubEvent[]
  staffAssignments       StaffAssignment[]
  workflowTasks          WorkflowTask[]
  documentTemplates      DocumentTemplate[]
  userAgreements         UserAgreement[]
  storageIntegrations    StorageIntegration[]
  storageRecords         StorageRecord[]
  clientSelections       ClientSelection[]
  selectionItems         SelectionItem[]
  galleryFolders         GalleryFolder[]
  galleryPhotos          GalleryPhoto[]
  albumProjects          AlbumProject[]
  albumPages             AlbumPage[]
  albumComments          AlbumComment[]
  tenantIntegrations     TenantIntegration[]
  equipments             Equipment[]
  postProductionJobs     PostProductionJob[]
  accounts               Account[]
  financialVouchers      FinancialVoucher[]
  promotionalOffers      PromotionalOffer[]
  subscription           TenantSubscription?
  transactions           BillingTransaction[]
  shootGearAllocations   ShootGearAllocation[]
  callSheets             CallSheet[]
  dispatchLogs           DispatchLog[]
  dataIngestionJobs      DataIngestionJob[]
  creditNotes            CreditNote[]
  equipmentMaintenances  EquipmentMaintenance[]
  gearCheckLogs          GearCheckLog[]
  clientGalleries        ClientGallery[]
  photoSelections        PhotoSelection[]
  guestLeads             GuestLead[]
  vehicles               Vehicle[]
  vehicleBookings        VehicleBooking[]
  isFranchisor           Boolean                  @default(false)
  parentTenantId         String?                  @db.Uuid
  parentTenant           Tenant?                  @relation("FranchiseHierarchy", fields: [parentTenantId], references: [id], onDelete: SetNull)
  franchisees            Tenant[]                 @relation("FranchiseHierarchy")
  royaltyPercent         Decimal?                 @db.Decimal(5, 2)
  franchisorRoyalties    FranchiseRoyaltyLedger[] @relation("FranchisorRoyalties")
  franchiseeRoyalties    FranchiseRoyaltyLedger[] @relation("FranchiseeRoyalties")
  enabledAddons            String[]                 @default([])
  aiEventCredits           Int                      @default(0)
  extraBranchUnits         Int                      @default(0)
  extraStaffUnits          Int                      @default(0)
  referredByDealerId         String?
  referredByDealer           DealerProfile?           @relation(fields: [referredByDealerId], references: [id], onDelete: SetNull)
  firstPaymentDiscountUsed   Boolean                  @default(false)
  dealerCommissions          DealerCommissionLedger[]

  @@index([referredByDealerId])

  @@index([slug])
  @@index([contactPhone])
  @@index([panNumber])
  @@index([parentTenantId])
}

model Subscription {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  planTier  PlanTier
  status    SubscriptionStatus @default(ACTIVE)
  stripeId  String?            @unique
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model SubscriptionPlan {
  id                       String   @id @default(cuid())
  name                     String
  slug                     String   @unique
  originalMonthlyPrice     Decimal? @db.Decimal(10, 2)
  monthlyPrice             Decimal  @db.Decimal(10, 2)
  originalAnnualPrice      Decimal? @db.Decimal(10, 2)
  annualPrice              Decimal  @db.Decimal(10, 2)
  offerBadgeText           String?
  isBasePlan               Boolean  @default(false)
  sortOrder                Int      @default(0)
  maxBranches              Int      @default(1)
  maxStaff                 Int      @default(3)
  smsCredits               Int      @default(0)
  whatsappCredits          Int      @default(0)
  allowFranchises          Boolean  @default(false)
  franchiseEnabled         Boolean  @default(false)
  includedAddons           String[] @default([])
  features                 String[] @default([])
  perFranchiseMonthlyPrice Decimal? @default(0) @db.Decimal(10, 2)
  perFranchiseAnnualPrice  Decimal? @default(0) @db.Decimal(10, 2)
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  subscriptions       TenantSubscription[]
  billingTransactions BillingTransaction[]
}

model PlanAddonConfig {
  id                   String   @id @default(cuid())
  featureKey           String   @unique
  name                 String
  description          String?
  originalMonthlyPrice Decimal? @db.Decimal(10, 2)
  monthlyPrice         Decimal  @default(0) @db.Decimal(10, 2)
  originalAnnualPrice  Decimal? @db.Decimal(10, 2)
  annualPrice          Decimal  @default(0) @db.Decimal(10, 2)
  billingType          String   @default("RECURRING")
  creditsIncluded      Int      @default(0)
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model TenantSubscription {
  id                     String           @id @default(cuid())
  tenantId               String           @unique @db.Uuid
  tenant                 Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  startDate              DateTime         @default(now())
  endDate                DateTime?
  billingCycle           BillingCycle     @default(MONTHLY)
  razorpaySubscriptionId String?          @unique
  razorpayCustomerId     String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([planId])
}

model BillingTransaction {
  id                String            @id @default(cuid())
  tenantId          String            @db.Uuid
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId            String?
  plan              SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  amount            Decimal           @db.Decimal(10, 2)
  currency          String            @default("INR")
  status            PaymentStatus     @default(PENDING)
  paymentMode       String?           @default("RAZORPAY")
  transactionRef    String?
  notes             String?
  purchaseType      String?           @default("SUBSCRIPTION")
  eventBookingId    String?           @db.Uuid
  addonFeatureKey   String?
  creditsPurchased  Int?              @default(0)
  unitsPurchased    Int?              @default(1)
  transactionDate   DateTime          @default(now())
  razorpayPaymentId String?           @unique
  razorpayOrderId   String?           @unique
  receiptUrl        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  dealerCommission  DealerCommissionLedger?

  @@index([tenantId])
  @@index([planId])
  @@index([status])
}

enum DealerCommissionStatus {
  PENDING
  PAID
  CANCELLED
}

model DealerProfile {
  id                          String                   @id @default(cuid())
  userId                      String                   @unique @db.Uuid
  user                        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealerCode                  String                   @unique
  businessName                String
  contactPerson               String
  phone                       String
  city                        String?
  commissionPercent           Decimal                  @default(20) @db.Decimal(5, 2)
  firstPaymentDiscountPercent Decimal                  @default(10) @db.Decimal(5, 2)
  bankDetails                 String?
  isActive                    Boolean                  @default(true)
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt

  referredTenants             Tenant[]
  commissions                 DealerCommissionLedger[]
  payouts                     DealerPayout[]

  @@index([isActive])
}

model DealerCommissionLedger {
  id                   String                 @id @default(cuid())
  dealerId             String
  dealer               DealerProfile          @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  tenantId             String                 @db.Uuid
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billingTransactionId String                 @unique
  billingTransaction   BillingTransaction     @relation(fields: [billingTransactionId], references: [id], onDelete: Cascade)
  paymentCycleNumber   Int                    @default(1)
  grossPlanAmount      Decimal                @db.Decimal(10, 2)
  discountApplied      Decimal                @default(0) @db.Decimal(10, 2)
  netPaidAmount        Decimal                @db.Decimal(10, 2)
  commissionPercent    Decimal                @db.Decimal(5, 2)
  commissionAmount     Decimal                @db.Decimal(10, 2)
  status               DealerCommissionStatus @default(PENDING)
  payoutId             String?
  payout               DealerPayout?          @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdAt            DateTime               @default(now())

  @@index([dealerId, status])
  @@index([tenantId])
}

model DealerPayout {
  id             String                   @id @default(cuid())
  dealerId       String
  dealer         DealerProfile            @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  amount         Decimal                  @db.Decimal(10, 2)
  paymentMode    String
  transactionRef String
  notes          String?
  paidAt         DateTime                 @default(now())
  createdAt      DateTime                 @default(now())

  commissions    DealerCommissionLedger[]

  @@index([dealerId, paidAt])
}


model Branch {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code       String?
  name       String // maps to branchName
  shortName  String?
  logoUrl    String?
  gstNumber  String?
  email      String?
  phone      String?
  address    String?
  city       String?
  state      String?
  country    String   @default("US")
  postalCode String?
  latitude   Decimal? @db.Decimal(10, 8)
  longitude  Decimal? @db.Decimal(11, 8)
  timezone   String   @default("UTC")

  managerUserId String? @db.Uuid
  isHeadOffice  Boolean @default(false)
  isActive      Boolean @default(true)
  status        String? @default("ACTIVE")

  userBranches           UserBranch[]
  leads                  Lead[]
  equipments             Equipment[]
  vehicles               Vehicle[]
  customers              Customer[]
  inquiries              Inquiry[]
  quotationRevisions     QuotationRevision[]
  quotationRevisionItems QuotationRevisionItem[]

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  followUps            FollowUp[]
  packages             Package[]
  invoices             Invoice[]
  payments             Payment[]
  eventBookings        EventBooking[]
  shootGearAllocations ShootGearAllocation[]
  creditNotes          CreditNote[]
  attendances          Attendance[]
  leaveRequests        LeaveRequest[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

// ------------------------------------------------------
// USER & ROLE MANAGEMENT
// ------------------------------------------------------

model User {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role     Role    @default(STAFF)

  email        String
  passwordHash String?
  name         String

  canLogin           Boolean        @default(true)
  mustChangePassword Boolean        @default(false)
  status             UserStatus     @default(PENDING_INVITATION)
  employmentType EmploymentType @default(IN_HOUSE)
  isActive       Boolean        @default(true)
  monthlySalary  Decimal?       @db.Decimal(10, 2)
  baseSalary     Decimal?       @db.Decimal(10, 2)
  employeeCode   String?
  designation    String?
  department     String?
  phone          String?
  alternatePhone String?
  profileImage   String?
  joiningDate    DateTime?      @db.Date

  reportingManagerId String? @db.Uuid
  reportingManager   User?   @relation("ReportingManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports      User[]  @relation("ReportingManager")

  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  failedLoginAttempts Int       @default(0)
  isLocked            Boolean   @default(false)
  lockUntil           DateTime?

  // Profile fields
  emergencyContact Json?
  address          String?
  companyName      String?
  documents        Json?
  skills           String[]
  equipmentList    String?
  rating           Float?
  isBlacklisted    Boolean  @default(false)
  notes            String?

  // Banking & Statutory Tax Details (Freelancers & Staff)
  panNumber         String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String?
  bankBranch        String?
  accountHolderName String?
  upiId             String?
  dealerProfile     DealerProfile?

  branches        UserBranch[]
  roles           UserRole[]
  loginSessions   LoginSession[]
  passwordHistory PasswordHistory[]
  tokens          Token[]

  staffAssignments         StaffAssignment[]  @relation("AssignedCrew")
  assignedStaffAssignments StaffAssignment[]  @relation("StaffAssignedBy")
  userAgreements           UserAgreement[]
  attendances              Attendance[]
  leaveRequests            LeaveRequest[]
  payrolls                 Payroll[]
  workflowTasks            WorkflowTask[]
  auditLogs                AuditLog[]
  activityTimelines        ActivityTimeline[]
  attachments              Attachment[]
  createdCustomers         Customer[]         @relation("CustomerCreatedBy")
  updatedCustomers         Customer[]         @relation("CustomerUpdatedBy")
  deletedCustomers         Customer[]         @relation("CustomerDeletedBy")
  customer                 Customer?          @relation("CustomerUserAccount")

  assignedInquiries Inquiry[] @relation("InquiryAssignedTo")
  createdInquiries  Inquiry[] @relation("InquiryCreatedBy")
  updatedInquiries  Inquiry[] @relation("InquiryUpdatedBy")
  deletedInquiries  Inquiry[] @relation("InquiryDeletedBy")

  assignedLeads Lead[] @relation("LeadAssignedTo")
  createdLeads  Lead[] @relation("LeadCreatedBy")
  updatedLeads  Lead[] @relation("LeadUpdatedBy")
  deletedLeads  Lead[] @relation("LeadDeletedBy")

  assignedFollowUps FollowUp[] @relation("FollowUpAssignedTo")
  createdFollowUps  FollowUp[] @relation("FollowUpCreatedBy")
  updatedFollowUps  FollowUp[] @relation("FollowUpUpdatedBy")
  deletedFollowUps  FollowUp[] @relation("FollowUpDeletedBy")

  createdPackages Package[] @relation("PackageCreatedBy")
  updatedPackages Package[] @relation("PackageUpdatedBy")
  deletedPackages Package[] @relation("PackageDeletedBy")

  quotationRevisionsCreated     QuotationRevision[]     @relation("QuotationRevisionCreatedBy")
  quotationRevisionsUpdated     QuotationRevision[]     @relation("QuotationRevisionUpdatedBy")
  quotationRevisionsDeleted     QuotationRevision[]     @relation("QuotationRevisionDeletedBy")
  quotationRevisionItemsCreated QuotationRevisionItem[] @relation("QuotationRevisionItemCreatedBy")
  quotationRevisionItemsUpdated QuotationRevisionItem[] @relation("QuotationRevisionItemUpdatedBy")
  quotationRevisionItemsDeleted QuotationRevisionItem[] @relation("QuotationRevisionItemDeletedBy")

  createdInvoices          Invoice[]             @relation("InvoiceCreatedBy")
  updatedInvoices          Invoice[]             @relation("InvoiceUpdatedBy")
  createdCreditNotes       CreditNote[]          @relation("CreditNoteCreatedBy")
  createdPayments          Payment[]             @relation("PaymentCreatedBy")
  createdEventBookings     EventBooking[]        @relation("EventBookingCreatedBy")
  eventAssignments         EventAssignment[]     @relation("EventAssignedCrew")
  assignedEventAssignments EventAssignment[]     @relation("EventAssignedBy")
  editedAlbums             AlbumProject[]        @relation("AlbumEditor")
  albumComments            AlbumComment[]        @relation("AlbumCommentAuthor")
  assignedGearAllocations  ShootGearAllocation[] @relation("AssignedGearUser")
  directedCallSheets       CallSheet[]           @relation("CallSheetDirector")
  dispatchLogs             DispatchLog[]
  handedOverIngestionJobs  DataIngestionJob[]    @relation("IngestionHandedOverBy")
  receivedIngestionJobs    DataIngestionJob[]    @relation("IngestionReceivedBy")

  gearCheckLogsVerified        GearCheckLog[]         @relation("GearCheckVerifiedBy")
  equipmentMaintenancesCreated EquipmentMaintenance[] @relation("MaintenanceCreatedBy")
  createdBroadcasts            PlatformBroadcast[]    @relation("BroadcastCreator")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tenantId, email])
  @@index([tenantId])
}

model UserBranch {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId String @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  isPrimary Boolean @default(false)
  isActive  Boolean @default(true)

  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, branchId])
}

model TenantRole {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isSystem    Boolean @default(false)

  permissions RolePermission[]
  users       UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@map("Role")
}

model Permission {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name   String
  module String
  action String

  roles RolePermission[]

  createdAt DateTime @default(now())

  @@unique([module, action])
}

model RolePermission {
  roleId       String     @db.Uuid
  role         TenantRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
